# Copy to .env and adjust. .env is never committed.

# Images: registry/namespace and version. Images loaded from a release archive are named dispofold.invalid/...
# (a name that never resolves, so Docker never pulls them from elsewhere); for images from a registry use
# <registry host>/<namespace>. TAG is the release version, e.g. 1.0.0.
REGISTRY=dispofold.invalid
TAG=

# To build the images from the source instead (development), uncomment:
# COMPOSE_FILE=docker-compose.yml:docker-compose.build.yml

# Port of the web interface on the host
HTTP_PORT=8080

# PostgreSQL
DB_NAME=dienstplanung
DB_USER=dienstplanung
DB_PASSWORD=

# Users: name:bcrypt-hash:role, separated by commas. Roles: planner (edit), viewer (read only).
# Only bcrypt hashes are accepted (see README); put the whole value in single quotes.
APP_USERS=

# Key for the login session cookie: at least 32 random characters, e.g. `openssl rand -base64 48`.
SESSION_ENCRYPTION_KEY=

# Solver: time limit as a safety net and early stop when the score has not improved for this long (seconds),
# random seed
SOLVER_TIME_LIMIT_SECONDS=300
SOLVER_UNIMPROVED_SECONDS=30
SOLVER_SEED=1
# Stop after this many moves (0: off). With the same seed and data the plan is then reproducible.
SOLVER_MOVE_LIMIT=250000

# Java memory for the backend
JAVA_OPTS=-XX:MaxRAMPercentage=75
