    "check:exports": "node scripts/build.mjs && node scripts/check-exports.mjs",
    "check:forms": "node scripts/build.mjs && node scripts/check-forms.mjs",
    "check:print": "node scripts/build.mjs && node scripts/check-print.mjs",
    "check:plan-views": "node scripts/build.mjs && node scripts/check-plan-views.mjs",
    "check:desktop": "node scripts/build.mjs && node scripts/check-desktop.mjs",
    "check:rules-person": "node scripts/build.mjs && node scripts/check-rules-person.mjs",
    "check:terms": "node scripts/build.mjs && node scripts/check-terms.mjs",
    "check:night": "node scripts/build.mjs && node scripts/check-night.mjs",
    "check:problems": "node scripts/build.mjs && node scripts/check-problems.mjs",
    "check:people": "node scripts/build.mjs && node scripts/check-people.mjs",
    "check:inputs": "node scripts/build.mjs && node scripts/check-inputs.mjs",
    "check:data": "node scripts/build.mjs && node scripts/check-data.mjs",
    "check:help": "node scripts/build.mjs && node scripts/check-help.mjs"
